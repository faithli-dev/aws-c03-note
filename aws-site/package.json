{
  "name": "aws-tutorial-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AWS 教學網站 — 每個 service 一頁，Bun + React + framer-motion，編譯成 standalone HTML",
  "scripts": {
